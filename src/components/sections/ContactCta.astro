---
import chevron from '../../assets/images/cta/select-chevron.svg';

const perks = [
	{ n: '01', title: 'Fast response', body: 'Expect a thoughtful reply within two business days.' },
	{ n: '02', title: 'No generic pitch', body: 'Your first conversation is shaped around your challenge.' },
	{ n: '03', title: 'Global partnership', body: 'We work with ambitious healthcare teams worldwide.' },
];

const goals = ['Patient acquisition', 'Brand strategy', 'Content & social', 'Launch a new practice', 'Something else'];

const field =
	'w-full rounded-[0.625rem] border-[0.05rem] border-solid border-[rgba(15,23,42,0.1)] bg-[#f6f8f8] px-[0.8125rem] py-[0.75rem] text-[0.875rem] text-ink placeholder:text-[rgba(15,23,42,0.5)] focus:border-brand focus:outline-none';
const label = 'flex flex-col gap-[0.4375rem] text-[1rem] leading-[1.125rem] font-medium text-ink';
---

<section
	class="relative overflow-hidden bg-ink p-[6.25rem]"
	id="book"
	style="background-image:radial-gradient(ellipse 18% 30% at 18% 18%, rgba(30,112,184,0.24), transparent 100%), radial-gradient(ellipse 18% 28% at 83% 40%, rgba(234,216,123,0.09), transparent 100%);"
	data-cta
>
	<div class="pointer-events-none absolute top-[25.82187rem] right-[-5.4375rem] size-[43.75rem] rounded-full" style="background:radial-gradient(circle at 50% 50%, rgba(22,136,194,0.2), transparent 65%);" data-depth="0.1"></div>

	<div class="relative mx-auto flex w-[77.5rem] items-center justify-between">
		<div class="flex w-[32.125rem] shrink-0 flex-col gap-[2.625rem]" data-cta-copy>
			<div class="flex flex-col gap-[1rem]">
				<p class="text-[1rem] leading-[1.125rem] font-bold tracking-[0.0975rem] whitespace-nowrap text-[#f2dc60] uppercase">Ready to grow with control?</p>
				<h2 class="w-[30.8125rem] text-[3.875rem] leading-[4.1075rem] font-bold tracking-[-0.21313rem] text-white">Let's engineer your next stage of growth.</h2>
				<p class="text-[1.25rem] text-[rgba(255,255,255,0.62)]">
					Tell us where you are, what is getting in the way, and where you want to go. We'll come back with the right clinical, creative, and commercial minds around the table.
				</p>
			</div>
			<ul class="w-[27.14375rem] border-t-[0.05rem] border-solid border-[#2c384a]">
				{
					perks.map((p, i) => (
						<li class:list={['flex items-center justify-between py-[0.8125rem]', i > 0 && 'border-t border-solid border-[#2c3344]']}>
							<span class="text-[1.25rem] leading-[0.84375rem] font-extrabold tracking-[0.045rem] text-gold">{p.n}</span>
							<div class="w-[24.51875rem]">
								<p class="pb-[0.125rem] text-[1.125rem] leading-[1.35625rem] font-bold whitespace-nowrap text-white">{p.title}</p>
								<p class="text-[1rem] leading-[1.1625rem] whitespace-nowrap text-[rgba(255,255,255,0.5)]">{p.body}</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>

		<!--
			TODO: no backend yet. Point `action` at the form endpoint (Formspree, Vercel function, etc.)
			and remove the preventDefault in the script below.
		-->
		<form
			class="flex w-[35.98125rem] shrink-0 flex-col gap-[1.5625rem] rounded-[1.5rem] bg-white p-[1.875rem] drop-shadow-[0_2.125rem_2.8125rem_rgba(0,0,0,0.28)]"
			data-cta-form
			novalidate
		>
			<div class="flex items-center justify-between border-b-[0.05rem] border-solid border-[rgba(15,23,42,0.1)] pb-[1.125rem]">
				<p class="text-[1.3125rem] leading-[1.96875rem] font-semibold tracking-[-0.03938rem] whitespace-nowrap text-ink">Start a conversation</p>
				<p class="text-[0.625rem] leading-[0.9375rem] font-semibold whitespace-nowrap text-[#248456]">Usually replies in 48 hours</p>
			</div>

			<div class="grid grid-cols-2 gap-[0.875rem]">
				<label class={label}>
					Your name
					<input class={field} type="text" name="name" placeholder="Dr. Maya Haddad" autocomplete="name" required />
				</label>
				<label class={label}>
					Work email
					<input class={field} type="email" name="email" placeholder="maya@clinic.com" autocomplete="email" required />
				</label>
			</div>

			<div class="grid grid-cols-2 gap-[0.875rem]">
				<label class={label}>
					Organization
					<input class={field} type="text" name="organization" placeholder="Clinic or company name" autocomplete="organization" />
				</label>
				<label class={label}>
					Primary goal
					<select
						class={`${field} appearance-none bg-no-repeat pr-[2.5rem]`}
						style={`background-image:url("${chevron.src}");background-position:right 0.9rem center;background-size:0.625rem 0.375rem;`}
						name="goal"
					>
						<option value="">Select a growth goal</option>
						{goals.map((g) => <option value={g}>{g}</option>)}
					</select>
				</label>
			</div>

			<label class={label}>
				What are you trying to solve?
				<textarea class={`${field} min-h-[6.5625rem] resize-y leading-[1.3125rem]`} name="message" placeholder="Share your current challenge, ambition, and timing..."></textarea>
			</label>

			<button
				type="submit"
				class="flex h-[3rem] w-full cursor-pointer items-center justify-center rounded-[0.625rem] bg-brand text-[0.9375rem] leading-[1.40625rem] font-bold text-white transition hover:brightness-110"
			>
				Send us brief
			</button>
		</form>
	</div>
</section>

<script>
	document.querySelector<HTMLFormElement>('[data-cta-form]')?.addEventListener('submit', (e) => {
		e.preventDefault();
		const form = e.currentTarget as HTMLFormElement;
		if (!form.reportValidity()) return;
		// TODO: submit to the real endpoint once the backend is decided.
	});
</script>
