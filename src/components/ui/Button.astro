---
interface Props {
	/** Renders a link when set, otherwise a <button type="button">. */
	href?: string;
	variant?: 'primary' | 'outline' | 'gold';
	class?: string;
	'aria-haspopup'?: 'dialog' | 'menu' | 'listbox';
	[attr: `data-${string}`]: string | boolean | undefined;
}

const { href, variant = 'primary', class: className = '', ...attrs } = Astro.props;

const variants = {
	primary:
		'bg-brand text-white font-semibold rounded-[0.375rem] px-[1.25rem] py-[0.875rem] drop-shadow-[0_0.375rem_0.46875rem_rgba(7,128,187,0.13)] hover:brightness-110',
	gold:
		'bg-sun text-[#0b1730] font-bold rounded-[0.375rem] px-[1.25rem] py-[0.875rem] drop-shadow-[0_0.375rem_0.46875rem_rgba(7,128,187,0.13)] hover:brightness-105',
	outline:
		'border-gold border-[0.05rem] border-solid text-gold font-bold rounded-[0.75rem] px-[1.125rem] py-[0.875rem] hover:bg-gold/10',
};

const classes = [
	'inline-flex cursor-pointer items-center justify-center gap-[0.75rem] text-[1.25rem] leading-[1.125rem] whitespace-nowrap transition duration-200',
	variants[variant],
	className,
];
---

{
	href ? (
		<a href={href} class:list={classes} {...attrs}>
			<slot />
		</a>
	) : (
		<button type="button" class:list={classes} {...attrs}>
			<slot />
		</button>
	)
}
